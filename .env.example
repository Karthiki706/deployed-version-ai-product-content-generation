# Google Gemini API Configuration
# Paste your Gemini API key (should start with AIzaSy)
GEMINI_API_KEY=

# Model Configuration
# Primary model to invoke
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TEMPERATURE=0.2
GEMINI_TOP_P=0.95
GEMINI_TIMEOUT=180

# Failover & Resiliency Settings
# Maximum API retries per model call on transient failures
MAX_API_RETRIES=5
# Multiplier for exponential backoff (delay = (backoff_multiplier ** retry_count) + random(0, 1))
BACKOFF_MULTIPLIER=2.0
# Comma-separated chain of fallback models if primary fails
FALLBACK_MODELS=gemini-2.5-flash,gemini-2.0-flash

# Circuit Breaker Configuration
# Trip the circuit if this many consecutive failures occur
CIRCUIT_FAILURE_THRESHOLD=3
# Duration in seconds to wait before checking if the API has recovered
CIRCUIT_RECOVERY_TIME=60.0

# Pipeline Configuration (Correction Loop)
MAX_RETRIES=3
QUALITY_THRESHOLD=85.0
HALLUCINATION_THRESHOLD=100.0

# Backend Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Directory Configuration
OUTPUTS_DIR=./outputs
PROMPTS_DIR=./app/prompts

# ---- Agentic mode ----
AGENTIC_MODE=true
AGENT_MAX_TOOL_STEPS=8
AGENT_STEP_TIMEOUT=60
LLM_PLANNER_ENABLED=true
LLM_SUPERVISOR_ENABLED=true
